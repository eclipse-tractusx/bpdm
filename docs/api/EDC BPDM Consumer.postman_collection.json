		{
			"name": "Negotiate for Access",
			"item": [
				{
					"name": "1. Select Asset",
					"item": [
						{
							"name": "Select Pool Participant Read Access",
							"event": [
								{
									"listen": "test",
									"script": {
										"exec": [
											"const KEY     = \"POOL_PARTICIPANT_READ\";",
											"const PURPOSE = \"cx.bpdm.pool:1\";",
											"",
											"pm.test(\"Catalog returned an offer\", function () {",
											"    pm.response.to.have.status(200);",
											"    pm.expect(pm.response.json().dataset, \"dataset\").to.be.an(\"array\").that.is.not.empty;",
											"});",
											"",
											"const v = pm.collectionVariables;",
											"const dataset = pm.response.json().dataset[0];",
											"",
											"v.set(\"SELECTED_KEY\", KEY);",
											"v.set(\"SELECTED_ASSET\", dataset[\"@id\"]);",
											"v.set(\"SELECTED_PURPOSE\", PURPOSE);",
											"v.set(\"OFFER\", dataset.hasPolicy[0][\"@id\"]);",
											"",
											"// restore whatever was already negotiated for this asset",
											"const agreement = v.get(\"AGREEMENT_\" + KEY) || \"\";",
											"v.set(\"AGREEMENT\", agreement);",
											"const token = pm.variables.get(\"TRANSFER_TOKEN_\" + KEY) || \"\";",
											"v.set(\"TRANSFER_TOKEN\", token);",
											"if (pm.environment.name) pm.environment.set(\"TRANSFER_TOKEN\", token);",
											"",
											"console.log(agreement",
											"    ? \"[\" + KEY + \"] agreement \" + agreement + \" exists - skip step 2, go to Get Transfer Token\"",
											"    : \"[\" + KEY + \"] not negotiated yet - run step 2\");"
										],
										"type": "text/javascript",
										"packages": {}
									}
								}
							],
							"request": {
								"method": "POST",
								"header": [],
								"body": {
									"mode": "raw",
									"raw": "{\r\n    \"@context\": {\r\n        \"@vocab\": \"https://w3id.org/edc/v0.0.1/ns/\"\r\n    },\r\n    \"@type\": \"CatalogRequest\",\r\n    \"counterPartyAddress\": \"{{PROVIDER_EDC_DATASPACE_API}}\",\r\n    \"counterPartyId\": \"{{PROVIDER_DID}}\",\r\n    \"protocol\": \"dataspace-protocol-http:2025-1\",\r\n    \"querySpec\": {\r\n        \"offset\": 0,\r\n        \"limit\": 1,\r\n        \"filterExpression\": [\r\n            {\r\n                \"operandLeft\": \"'http://purl.org/dc/terms/type'.'@id'\",\r\n                \"operator\": \"=\",\r\n                \"operandRight\": \"https://w3id.org/catenax/taxonomy#BPDMPool\"\r\n            },\r\n            {\r\n                \"operandLeft\": \"'http://purl.org/dc/terms/subject'.'@id'\",\r\n                \"operator\": \"=\",\r\n                \"operandRight\": \"https://w3id.org/catenax/taxonomy#ReadAccessPoolForDataSpaceParticipant\"\r\n            },\r\n            {\r\n                \"operandLeft\": \"https://w3id.org/catenax/ontology/common#version\",\r\n                \"operator\": \"=\",\r\n                \"operandRight\": \"7\"\r\n            }\r\n        ]\r\n    }\r\n}",
									"options": {
										"raw": {
											"language": "json"
										}
									}
								},
								"url": {
									"raw": "{{CONSUMER_EDC_MANAGEMENT_API}}/v3/catalog/request",
