				{
					"name": "2. Negotiate",
					"item": [
						{
							"name": "Negotiate Selected Asset",
							"event": [
								{
									"listen": "prerequest",
									"script": {
										"exec": [
											"const v = pm.collectionVariables;",
											"if (!v.get(\"SELECTED_ASSET\")) {",
											"    throw new Error(\"Run 1. Select Asset first.\");",
											"}",
											"if (v.get(\"AGREEMENT_\" + v.get(\"SELECTED_KEY\"))) {",
											"    console.warn(\"[\" + v.get(\"SELECTED_KEY\") + \"] already negotiated - this creates a SECOND agreement.\");",
											"}"
										],
										"type": "text/javascript",
										"packages": {}
									}
								},
								{
									"listen": "test",
									"script": {
										"exec": [
											"pm.test(\"Negotiation started\", function () {",
											"    pm.response.to.have.status(200);",
											"});",
											"pm.collectionVariables.set(\"NEGOTIATION\", pm.response.json()[\"@id\"]);"
										],
										"type": "text/javascript",
										"packages": {}
									}
								}
							],
							"request": {
								"method": "POST",
								"header": [],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"@context\": [\n        \"https://w3id.org/dspace/2025/1/odrl-profile.jsonld\",\n        \"https://w3id.org/catenax/2025/9/policy/context.jsonld\",\n        {\n            \"@vocab\": \"https://w3id.org/edc/v0.0.1/ns/\"\n        }\n    ],\n    \"@type\": \"ContractRequest\",\n    \"counterPartyAddress\": \"{{PROVIDER_EDC_DATASPACE_API}}\",\n    \"protocol\": \"dataspace-protocol-http:2025-1\",\n    \"counterPartyId\": \"{{PROVIDER_DID}}\",\n    \"policy\": {\n        \"@id\": \"{{OFFER}}\",\n        \"@type\": \"Offer\",\n        \"permission\": [\n            {\n                \"action\": \"use\",\n                \"constraint\": {\n                    \"and\": [\n                        {\n                            \"leftOperand\": \"FrameworkAgreement\",\n                            \"operator\": \"eq\",\n                            \"rightOperand\": \"DataExchangeGovernance:1.0\"\n                        },\n                        {\n                            \"leftOperand\": \"UsagePurpose\",\n                            \"operator\": \"isAnyOf\",\n                            \"rightOperand\": \"{{SELECTED_PURPOSE}}\"\n                        }\n                    ]\n                }\n            }\n        ],\n        \"target\": \"{{SELECTED_ASSET}}\",\n        \"assigner\": \"{{PROVIDER_DID}}\"\n    }\n}",
									"options": {
										"raw": {
											"language": "json"
										}
									}
								},
								"url": {
									"raw": "{{CONSUMER_EDC_MANAGEMENT_API}}/v3/edrs",
									"host": [
										"{{CONSUMER_EDC_MANAGEMENT_API}}"
									],
									"path": [
										"v3",
										"edrs"
									]
								}
							},
							"response": []
						},
						{
							"name": "Confirm Agreement",
							"event": [
								{
									"listen": "test",
									"script": {
										"exec": [
											"const v = pm.collectionVariables;",
											"const body = pm.response.json();",
											"",
											"pm.test(\"Negotiation not terminated\", function () {",
											"    pm.expect(body.state, body.errorDetail || \"\").to.not.equal(\"TERMINATED\");",
											"});",
											"",
											"if (body.state !== \"FINALIZED\") {",
											"    const tries = Number(v.get(\"NEGOTIATION_TRIES\") || 0) + 1;",
											"    v.set(\"NEGOTIATION_TRIES\", tries);",
											"    console.log(\"state=\" + body.state + \" - re-send this request (poll \" + tries + \")\");",
											"    if (tries < 10) {",
											"        postman.setNextRequest(\"Confirm Agreement\");   // Collection Runner only",
											"    }",
											"    return;",
											"}",
											"",
											"v.unset(\"NEGOTIATION_TRIES\");",
											"const KEY = v.get(\"SELECTED_KEY\");",
											"v.set(\"AGREEMENT\", body.contractAgreementId);",
											"v.set(\"AGREEMENT_\" + KEY, body.contractAgreementId);",
											"console.log(\"[\" + KEY + \"] agreement \" + body.contractAgreementId + \" stored - step 2 never needed again\");"
										],
										"type": "text/javascript",
										"packages": {}
									}
								}
							],
							"request": {
								"method": "GET",
								"header": [],
								"url": {
									"raw": "{{CONSUMER_EDC_MANAGEMENT_API}}/v3/contractnegotiations/{{NEGOTIATION}}",
									"host": [
										"{{CONSUMER_EDC_MANAGEMENT_API}}"
									],
									"path": [
										"v3",
										"contractnegotiations",
										"{{NEGOTIATION}}"
									]
								}
							},
							"response": []
						}
					]
				},
				{
					"name": "3. Access",
					"item": [
						{
							"name": "Start New Transfer",
							"event": [
								{
									"listen": "prerequest",
									"script": {
										"exec": [
											"const v = pm.collectionVariables;",
											"if (!v.get(\"AGREEMENT\")) {",
											"    throw new Error(\"No agreement selected - run 1. Select Asset (and 2. Negotiate if needed).\");",
											"}"
										],
										"type": "text/javascript",
										"packages": {}
									}
								},
								{
									"listen": "test",
									"script": {
										"exec": [
											"pm.test(\"Transfer started\", function () {",
											"    pm.response.to.have.status(200);",
											"});",
											"const tp = pm.response.json()[\"@id\"];",
											"pm.collectionVariables.set(\"TRANSFERPROCESS\", tp);",
											"console.log(\"transfer \" + tp + \" requested - once it reaches STARTED, Get Transfer Token will find its EDR\");"
										],
										"type": "text/javascript",
										"packages": {}
									}
								}
							],
							"request": {
								"method": "POST",
								"header": [],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"@context\": {\n        \"@vocab\": \"https://w3id.org/edc/v0.0.1/ns/\"\n    },\n    \"@type\": \"TransferRequest\",\n    \"contractId\": \"{{AGREEMENT}}\",\n    \"counterPartyAddress\": \"{{PROVIDER_EDC_DATASPACE_API}}\",\n    \"protocol\": \"dataspace-protocol-http:2025-1\",\n    \"transferType\": \"HttpData-PULL\",\n    \"dataDestination\": {\n        \"type\": \"HttpProxy\"\n    }\n}",
									"options": {
										"raw": {
											"language": "json"
										}
									}
								},
								"url": {
									"raw": "{{CONSUMER_EDC_MANAGEMENT_API}}/v3/transferprocesses",
									"host": [
										"{{CONSUMER_EDC_MANAGEMENT_API}}"
									],
									"path": [
										"v3",
										"transferprocesses"
									]
								}
							},
							"response": []
						},
						{
							"name": "Find Transfer Process",
							"event": [
								{
									"listen": "prerequest",
									"script": {
										"exec": [
											"const v = pm.collectionVariables;",
											"if (!v.get(\"AGREEMENT\")) {",
											"    throw new Error(\"No agreement selected - run 1. Select Asset (and 2. Negotiate if needed).\");",
											"}"
										],
										"type": "text/javascript",
										"packages": {}
									}
								},
								{
									"listen": "test",
									"script": {
										"exec": [
											"const entries = pm.response.json();",
											"",
											"pm.test(\"EDR found for the agreement\", function () {",
											"    pm.response.to.have.status(200);",
											"    pm.expect(entries, \"EDR entries\").to.be.an(\"array\").that.is.not.empty;",
											"});",
											"",
											"if (!Array.isArray(entries) || entries.length === 0) {",
											"    console.log(\"No EDR for this agreement yet - the transfer may still be starting, \"",
											"              + \"or run 3. Access / Start New Transfer.\");",
											"    return;",
											"}",
											"",
											"// newest first; a replaced transfer leaves older entries behind",
											"entries.sort(function (a, b) { return (b.createdAt || 0) - (a.createdAt || 0); });",
											"pm.collectionVariables.set(\"TRANSFERPROCESS\", entries[0].transferProcessId);",
											"console.log(\"transfer process \" + entries[0].transferProcessId",
											"          + \" - Get Transfer Token can now be re-sent as often as needed\");"
										],
										"type": "text/javascript",
										"packages": {}
									}
								}
							],
							"request": {
								"method": "POST",
								"header": [],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"@context\": {\n        \"@vocab\": \"https://w3id.org/edc/v0.0.1/ns/\"\n    },\n    \"@type\": \"QuerySpec\",\n    \"offset\": 0,\n    \"limit\": 50,\n    \"filterExpression\": [\n        {\n            \"operandLeft\": \"agreementId\",\n            \"operator\": \"=\",\n            \"operandRight\": \"{{AGREEMENT}}\"\n        }\n    ]\n}",
									"options": {
										"raw": {
											"language": "json"
										}
									}
								},
								"url": {
									"raw": "{{CONSUMER_EDC_MANAGEMENT_API}}/v3/edrs/request",
									"host": [
										"{{CONSUMER_EDC_MANAGEMENT_API}}"
									],
									"path": [
										"v3",
										"edrs",
										"request"
									]
								}
							},
							"response": []
						},
						{
							"name": "Get Transfer Token",
							"event": [
								{
									"listen": "prerequest",
									"script": {
										"exec": [
											"const v = pm.collectionVariables;",
											"if (!v.get(\"AGREEMENT\")) {",
											"    throw new Error(\"No agreement selected - run 1. Select Asset (and 2. Negotiate if needed).\");",
											"}",
											"if (!v.get(\"TRANSFERPROCESS\")) {",
											"    throw new Error(\"No transfer process - run 3. Access / Find Transfer Process.\");",
											"}"
										],
										"type": "text/javascript",
										"packages": {}
									}
								},
								{
									"listen": "test",
									"script": {
										"exec": [
											"pm.test(\"Got an EDR\", function () {",
											"    pm.response.to.have.status(200);",
											"});",
											"",
											"const v = pm.collectionVariables;",
											"const edr = pm.response.json();",
											"",
											"// Published to the environment, not to this collection: an API collection imported from an",
											"// access group document is a different collection and cannot read collection variables of this",
											"// one. Environment variables are shared, and beat a collection variable of the same name, so the",
											"// imported collection needs no baseUrl edit of its own.",
											"if (!pm.environment.name) {",
											"    throw new Error(\"Select an environment first - the transfer token is published to it so that an imported BPDM API collection can read it.\");",
											"}",
											"",
											"pm.environment.set(\"TRANSFER_TOKEN\", edr.authorization);",
											"pm.environment.set(\"TRANSFER_TOKEN_\" + v.get(\"SELECTED_KEY\"), edr.authorization);",
											"pm.environment.set(\"baseUrl\", edr.endpoint);"
										],
										"type": "text/javascript",
										"packages": {}
									}
								}
							],
							"protocolProfileBehavior": {
								"disableBodyPruning": true
							},
							"request": {
								"method": "GET",
								"header": [],
								"body": {
									"mode": "raw",
									"raw": "",
									"options": {
										"raw": {
											"language": "json"
										}
									}
								},
								"url": {
									"raw": "{{CONSUMER_EDC_MANAGEMENT_API}}/v3/edrs/{{TRANSFERPROCESS}}/dataaddress?auto_refresh=true",
									"host": [
										"{{CONSUMER_EDC_MANAGEMENT_API}}"
									],
									"path": [
										"v3",
										"edrs",
										"{{TRANSFERPROCESS}}",
										"dataaddress"
									],
									"query": [
										{
											"key": "auto_refresh",
											"value": "true"
										}
									]
								}
							},
							"response": []
						}
					]
				}
			]
		}
